# Local data directory. Defaults to ./data
KEYSTONE_DATA_DIR=./data

# Public demo password. Printed on the staff sign-in card.
DESK_PASSWORD=keystone-demo
DESK_SECRET=keystone-demo-secret

# Offline demo mode is the default. Set KEYSTONE_POLICY=rules to force it even when a key is present.
# KEYSTONE_POLICY=rules

# Free-tier models. Groq is tried first, then Gemini. Leave both unset for the deterministic desk.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Channel webhook verify tokens. Defaults to keystone-demo-verify.
# WHATSAPP_VERIFY_TOKEN=keystone-demo-verify
# MESSENGER_VERIFY_TOKEN=keystone-demo-verify
# Optional. When unset, the webhook returns the reply in JSON and does not call Meta.
# WHATSAPP_TOKEN=
# MESSENGER_PAGE_TOKEN=
